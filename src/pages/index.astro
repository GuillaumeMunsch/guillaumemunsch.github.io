---
import '@fontsource-variable/inter';
import '../styles/global.css';
import ArrowIcon from '@tabler/icons/outline/arrow-up-right.svg';
import GithubIcon from '@tabler/icons/outline/brand-github.svg';
import LinkedinIcon from '@tabler/icons/outline/brand-linkedin.svg';
import MailIcon from '@tabler/icons/outline/mail.svg';
import ProjectThumb from '../components/ProjectThumb.astro';
import { about, education, experiences, languages, profile, projects } from '../content';

const sections = [
  { id: 'cv', label: 'CV' },
  { id: 'projects', label: 'Projects' },
  { id: 'about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · {profile.title}</title>
    <meta name="description" content={`${profile.name}, ${profile.title}. ${profile.tagline}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page">
      <header class="side">
        <div>
          <h1 class="name"><a href="/">{profile.name}</a></h1>
          <p class="title">{profile.title}</p>
          <p class="tagline">{profile.tagline}</p>
          <nav class="nav" aria-label="Sections">
            <ul>
              {
                sections.map((section) => (
                  <li>
                    <a class="nav-link" href={`#${section.id}`} data-section={section.id}>
                      <span class="nav-line" />
                      <span>{section.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <ul class="socials" aria-label="Contact">
          <li>
            <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
              <GithubIcon width={24} height={24} aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <LinkedinIcon width={24} height={24} aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href={`mailto:${profile.email}`} aria-label="Email">
              <MailIcon width={24} height={24} aria-hidden="true" />
            </a>
          </li>
        </ul>
      </header>

      <main id="content">
        <section id="cv">
          <h2 class="section-title">CV</h2>
          <ol class="list">
            {
              experiences.map((experience) => (
                <li class="item">
                  <p class="dates">
                    {experience.start} – {experience.end}
                  </p>
                  <div>
                    <h3 class="item-title">
                      {experience.url ? (
                        <a class="stretched" href={experience.url} target="_blank" rel="noreferrer">
                          {experience.title} · {experience.company}
                          <ArrowIcon class="arrow" width={16} height={16} aria-hidden="true" />
                        </a>
                      ) : (
                        <span>
                          {experience.title} · {experience.company}
                        </span>
                      )}
                    </h3>
                    <p class="location">{experience.location}</p>
                    {experience.summary.map((paragraph) => (
                      <p class="summary">{paragraph}</p>
                    ))}
                    <ul class="tags" aria-label="Technologies">
                      {experience.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>

          <h3 class="sub-title">Education</h3>
          <ol>
            {
              education.map((entry) => (
                <li class="row">
                  <p class="dates">
                    {entry.start} – {entry.end}
                  </p>
                  <div>
                    <p class="strong">{entry.degree}</p>
                    <p>
                      {entry.url ? (
                        <a class="link" href={entry.url} target="_blank" rel="noreferrer">
                          {entry.school}
                        </a>
                      ) : (
                        entry.school
                      )}
                    </p>
                    {entry.note && <p class="summary">{entry.note}</p>}
                  </div>
                </li>
              ))
            }
          </ol>

          <h3 class="sub-title">Languages</h3>
          <ul class="languages">
            {
              languages.map((language) => (
                <li>
                  <span class="strong">{language.name}</span> {language.level}
                </li>
              ))
            }
          </ul>
        </section>

        <section id="projects">
          <h2 class="section-title">Projects</h2>
          <ul class="list">
            {
              projects.map((project) => (
                <li class="item project">
                  <div class="thumb">
                    <ProjectThumb type={project.thumb} />
                  </div>
                  <div>
                    <h3 class="item-title">
                      <a class="stretched" href={project.play}>
                        {project.name}
                        <ArrowIcon class="arrow" width={16} height={16} aria-hidden="true" />
                      </a>
                    </h3>
                    <p class="summary">{project.description}</p>
                    <ul class="tags" aria-label="Technologies">
                      {project.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                    <a class="code-link" href={project.code} target="_blank" rel="noreferrer">
                      <GithubIcon width={16} height={16} aria-hidden="true" />
                      Code
                    </a>
                  </div>
                </li>
              ))
            }
          </ul>
          <a class="more" href={profile.github} target="_blank" rel="noreferrer">
            More on GitHub
            <ArrowIcon class="arrow" width={16} height={16} aria-hidden="true" />
          </a>
        </section>

        <section id="about">
          <h2 class="section-title">About</h2>
          {about.map((paragraph) => <p class="about">{paragraph}</p>)}
        </section>

        <footer class="footer">
          <p>Built with Astro, deployed on GitHub Pages.</p>
        </footer>
      </main>
    </div>

    <script>
      const sections = [...document.querySelectorAll<HTMLElement>('main section')];
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')];

      const updateActiveLink = () => {
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const current = atBottom
          ? sections.at(-1)
          : sections.filter((section) => section.getBoundingClientRect().top <= window.innerHeight * 0.4).at(-1);
        const activeId = current?.id ?? sections[0]?.id;
        links.forEach((link) => link.classList.toggle('active', link.dataset.section === activeId));
      };

      updateActiveLink();
      window.addEventListener('scroll', updateActiveLink, { passive: true });
    </script>
  </body>
</html>

<style>
  .page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .side {
    padding: 48px 0;
  }

  .name {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--heading);
  }

  .title {
    margin-top: 12px;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--heading);
  }

  .tagline {
    margin-top: 16px;
    max-width: 20rem;
  }

  .nav {
    display: none;
  }

  .nav ul {
    margin-top: 64px;
    width: max-content;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 12px 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav-line {
    width: 32px;
    height: 1px;
    margin-right: 16px;
    background: var(--line);
    transition: width 0.15s, background-color 0.15s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--heading);
  }

  .nav-link:hover .nav-line,
  .nav-link.active .nav-line {
    width: 64px;
    background: var(--heading);
  }

  .socials {
    display: flex;
    gap: 20px;
    margin-top: 32px;
  }

  .socials a {
    display: block;
    transition: color 0.15s;
  }

  .socials a:hover {
    color: var(--heading);
  }

  main {
    padding-bottom: 48px;
  }

  section {
    margin-bottom: 64px;
    scroll-margin-top: 64px;
  }

  .section-title {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 -24px 16px;
    padding: 20px 24px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--heading);
  }

  .list > .item + .item {
    margin-top: 48px;
  }

  .item {
    position: relative;
    display: grid;
    gap: 8px;
    transition: background-color 0.15s, opacity 0.15s;
  }

  .row {
    display: grid;
    gap: 4px;
    margin-bottom: 16px;
  }

  .dates {
    margin-top: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .item-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--heading);
    transition: color 0.15s;
  }

  .item:hover .item-title,
  .item:focus-within .item-title {
    color: var(--accent);
  }

  .arrow {
    display: inline-block;
    margin-left: 4px;
    vertical-align: -2px;
    transition: transform 0.15s;
  }

  .item:hover .arrow,
  .item:focus-within .arrow,
  .more:hover .arrow {
    transform: translate(2px, -2px);
  }

  .stretched::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }

  .location {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .summary {
    margin-top: 8px;
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .tags li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tag-bg);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
  }

  .sub-title {
    margin: 48px 0 16px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--heading);
  }

  .strong {
    font-weight: 500;
    color: var(--heading);
  }

  .link {
    transition: color 0.15s;
  }

  .link:hover,
  .code-link:hover,
  .more:hover {
    color: var(--accent);
  }

  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .project .thumb {
    order: 2;
    max-width: 200px;
    padding: 8px;
    border: 2px solid rgba(226, 232, 240, 0.1);
    border-radius: 6px;
    background: rgba(2, 6, 23, 0.4);
    transition: border-color 0.15s;
  }

  .project:hover .thumb {
    border-color: rgba(226, 232, 240, 0.3);
  }

  .code-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-size: 0.875rem;
    transition: color 0.15s;
  }

  .more {
    display: inline-flex;
    align-items: center;
    margin-top: 48px;
    font-weight: 500;
    color: var(--heading);
    transition: color 0.15s;
  }

  .about + .about {
    margin-top: 16px;
  }

  .footer {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .item,
    .row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 16px;
    }

    .project .thumb {
      order: 0;
      align-self: start;
      margin-top: 4px;
    }
  }

  @media (min-width: 768px) {
    .page {
      padding: 0 48px;
    }

    .section-title {
      margin: 0 -48px 16px;
      padding: 20px 48px;
    }
  }

  @media (min-width: 1024px) {
    .page {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 0 96px;
    }

    .side {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 48%;
      max-height: 100vh;
      padding: 96px 0;
    }

    .name {
      font-size: 3rem;
    }

    .title {
      font-size: 1.25rem;
    }

    .nav {
      display: block;
    }

    main {
      width: 52%;
      padding: 96px 0;
    }

    section {
      margin-bottom: 144px;
      scroll-margin-top: 96px;
    }

    .section-title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .list > .item + .item {
      margin-top: 16px;
    }

    .item {
      margin: 0 -16px;
      padding: 16px;
      border-radius: 8px;
    }

    .item:hover {
      background: var(--surface);
      box-shadow: inset 0 1px 0 0 rgba(148, 163, 184, 0.1);
    }

    .list:hover > .item:not(:hover) {
      opacity: 0.5;
    }
  }
</style>
